NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# URL pública de Mora (emails y redirect de pago)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Bold — https://developers.bold.co/pagos-en-linea/llaves-de-integracion
# Panel → Integraciones → Llaves de integración (Botón de pagos / API Pagos en línea)
# test = desarrollo. prod = dinero real. Nunca mezclar.
# La secreta NO va al cliente.
# Webhooks (Bold → Integraciones → Webhooks):
# producción: https://moraring.com/api/bold/events
# pruebas:    https://moraring.com/api/bold/events/test
BOLD_ENV=test
BOLD_TEST_IDENTITY_KEY=
BOLD_TEST_SECRET_KEY=
BOLD_IDENTITY_KEY=
BOLD_SECRET_KEY=

# Addi — cuotas (BNPL). Addi envía Client ID, Secret y ally-slug por correo cifrado.
# Sandbox: ADDI_ENV=sandbox  ·  Producción: ADDI_ENV=prod
# Webhook que Addi debe apuntar (o el que mandamos en cada aplicación):
#   https://moraring.com/api/addi/events
# Redirección del cliente:
#   https://moraring.com/pago
ADDI_ENV=sandbox
ADDI_CLIENT_ID=
ADDI_CLIENT_SECRET=
ADDI_SANDBOX_CLIENT_ID=
ADDI_SANDBOX_CLIENT_SECRET=
ADDI_AUDIENCE=
ADDI_AUTH_URL=
ADDI_API_URL=
ADDI_WEBHOOK_SECRET=
ADDI_WEBHOOK_USER=
ADDI_WEBHOOK_PASSWORD=
ADDI_MIN_COP=50000
ADDI_MAX_COP=3000000
NEXT_PUBLIC_ADDI_ALLY_SLUG=

# Envia.com queda de respaldo si Heka no está configurado.
ENVIA_API_TOKEN=

# Heka Entrega — https://api.hekaentrega.co/docs
# Producción. El interruptor del super admin elige este entorno cuando "Usar Heka de producción" está encendido.
HEKA_API=https://api.hekaentrega.co
HEKA_API_KEY=
HEKA_EMAIL=
HEKA_PASSWORD=
HEKA_WAREHOUSE_ID=
# Demo (apidev). Se usa mientras el interruptor de producción está apagado.
HEKA_DEMO_API=https://apidev.hekaentrega.co
HEKA_DEMO_API_KEY=
HEKA_DEMO_EMAIL=
HEKA_DEMO_PASSWORD=
HEKA_DEMO_WAREHOUSE_ID=

# Resend (correo de compra y guía)
RESEND_API_KEY=
RESEND_FROM="Mora Ring <no-responder@moraring.com>"
MORA_SALES_EMAIL=

# Primer super admin en /acceso. Lo inventas tú; no sale de Bold ni Firebase.
ADMIN_SETUP_SECRET=mora-atelier-setup
BOOTSTRAP_ADMIN_EMAIL=superadmin@mora.com

# Opcional en local. En Firebase App Hosting se usa ADC.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Meta Ads — Pixel + Conversions API (también se pueden pegar en Superadmin → Campañas)
NEXT_PUBLIC_META_PIXEL_ID=
META_CAPI_TOKEN=
META_CAPI_TEST_EVENT_CODE=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# MATIAS — facturación electrónica DIAN. Se emite solo cuando Bold aprueba la venta.
# https://docs.matias-api.com/  Endpoint: /api/ubl2.1
# Email y password de la cuenta MATIAS. Resolución, prefijo y rango: los de Mora ante la DIAN.
MATIAS_API_BASE_URL=https://api-v2.matias-api.com/api/ubl2.1
MATIAS_EMAIL=
MATIAS_PASSWORD=
MATIAS_RESOLUTION_NUMBER=18764117275071
MATIAS_PREFIX=MORA
MATIAS_DOC_NUMBER_MIN=1
MATIAS_DOC_NUMBER_MAX=5000
MATIAS_DEFAULT_CITY_ID=149
MATIAS_DEFAULT_POSTAL_CODE=110111
MATIAS_MEANS_PAYMENT_ELECTRONIC=49
MATIAS_INVOICE_WITH_VAT=1

# WhatsApp Cloud API (Business). No es WhatsApp Web embebido.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
NEXT_PUBLIC_WHATSAPP_NUMBER=
WHATSAPP_WELCOME=
WHATSAPP_PREFILL=
