NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# URL pública de Mora (emails y redirect de pago)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Bold — https://developers.bold.co/pagos-en-linea/llaves-de-integracion
# Panel → Integraciones → Llaves de integración (Botón de pagos / API Pagos en línea)
# test = desarrollo. prod = dinero real. Nunca mezclar.
# La secreta NO va al cliente.
# Webhook de producción (Bold → Integraciones → Webhooks):
# https://moraring.com/api/bold/events
BOLD_ENV=test
BOLD_TEST_IDENTITY_KEY=
BOLD_TEST_SECRET_KEY=
BOLD_IDENTITY_KEY=
BOLD_SECRET_KEY=

# Envia.com (misma cotización que Mi Catálogo)
ENVIA_API_TOKEN=

# Resend (correo de compra y guía)
RESEND_API_KEY=
RESEND_FROM="Mora <hola@tu-dominio.com>"
MORA_SALES_EMAIL=

# Primer super admin en /acceso. Lo inventas tú; no sale de Bold ni Firebase.
ADMIN_SETUP_SECRET=mora-atelier-setup
BOOTSTRAP_ADMIN_EMAIL=superadmin@mora.com

# Opcional en local. En Firebase App Hosting se usa ADC.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Meta Ads — Pixel + Conversions API (también se pueden pegar en Superadmin → Campañas)
NEXT_PUBLIC_META_PIXEL_ID=
META_CAPI_TOKEN=
META_CAPI_TEST_EVENT_CODE=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# WhatsApp Cloud API (Business). No es WhatsApp Web embebido.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
NEXT_PUBLIC_WHATSAPP_NUMBER=
WHATSAPP_WELCOME=
WHATSAPP_PREFILL=
