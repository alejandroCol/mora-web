rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isStaff() {
      return request.auth != null
        && exists(/databases/$(database)/documents/staff/$(request.auth.uid));
    }

    function staffRole() {
      return get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.role;
    }

    function isSuperadmin() {
      return isStaff() && staffRole() == 'superadmin';
    }

    function isFounder() {
      return isStaff() && staffRole() == 'founder';
    }

    function isPrivileged() {
      return isSuperadmin() || isFounder();
    }

    match /staff/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isPrivileged());
      allow create: if request.auth != null && (
        request.auth.uid == uid
          && request.resource.data.email == request.auth.token.email
          && (request.resource.data.role == 'superadmin' || request.resource.data.role == 'founder')
        || isPrivileged()
      );
      allow update: if isPrivileged();
      allow delete: if false;
    }

    match /settings/{doc} {
      allow read, write: if doc == "growth" ? isPrivileged() : isStaff();
    }

    match /financeExpenses/{id} {
      allow read, write: if isFounder();
    }

    match /financeLoans/{id} {
      allow read, write: if isFounder();
    }

    match /financeOrders/{id} {
      allow read, write: if isFounder();
    }

    match /financeAttachments/{id} {
      allow read, write: if isFounder();
    }

    match /leads/{id} {
      allow read, write: if isStaff();
    }

    match /whatsappConversations/{id} {
      allow read, write: if isStaff();
      match /messages/{mid} {
        allow read, write: if isStaff();
      }
    }

    match /inventory/{sku} {
      allow read, write: if isStaff();
    }

    match /orders/{id} {
      allow read, write: if isStaff();
    }

    match /orderNumbers/{n} {
      allow read, write: if isStaff();
    }

    match /counters/{id} {
      allow read, write: if isStaff();
    }

    match /statsDaily/{day} {
      allow read, write: if isStaff();
    }

    match /gallery/{id} {
      allow read, write: if isStaff();
    }

    match /encuestaVotes/{id} {
      allow read, write: if false;
    }

    // Plano producto (Círculo). Staff NO lee salud.
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read, write: if isOwner(uid);
    }

    match /rings/{id} {
      allow read: if signedIn() && resource.data.ownerUid == request.auth.uid;
      allow write: if false;
    }

    match /daySummaries/{id} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    match /circles/{id} {
      allow read: if signedIn() && (
        resource.data.ownerUid == request.auth.uid
        || exists(/databases/$(database)/documents/circles/$(id)/memberships/$(request.auth.uid))
      );
      allow write: if false;
      match /memberships/{uid} {
        allow read: if signedIn() && (
          uid == request.auth.uid
          || get(/databases/$(database)/documents/circles/$(id)).data.ownerUid == request.auth.uid
          || exists(/databases/$(database)/documents/circles/$(id)/memberships/$(request.auth.uid))
        );
        allow write: if false;
      }
    }

    match /invites/{code} {
      allow read, write: if false;
    }

    match /emailInvites/{id} {
      allow read, write: if false;
    }

    match /userCircles/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
      match /items/{circleId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
